generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Budget {
  id                 String               @id
  userId             String
  context            String
  name               String
  category           String?
  amount             Float
  period             String               @default("monthly")
  startDate          DateTime
  endDate            DateTime?
  accountId          String?
  warningThreshold   Float                @default(80)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  FinanceAccount     FinanceAccount?      @relation(fields: [accountId], references: [id])
  User               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  BudgetTracking     BudgetTracking[]
  FinanceTransaction FinanceTransaction[]

  @@index([userId, context])
  @@index([userId, context, period])
}

model BudgetTracking {
  id            String    @id
  budgetId      String
  period        String
  spent         Float     @default(0)
  budgeted      Float
  status        String    @default("on_track")
  lastWarningAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Budget        Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, period])
  @@index([budgetId, period])
}

model Chat {
  id              String            @id
  type            String            @default("direct")
  groupId         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Group           Group?            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ChatParticipant ChatParticipant[]
  Message         Message[]
}

model ChatParticipant {
  id         String    @id
  chatId     String
  userId     String
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?
  Chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
}

model Chore {
  id                                        String            @id
  groupId                                   String?
  friendId                                  String?
  createdBy                                 String
  title                                     String
  description                               String?
  category                                  String?
  points                                    Int               @default(10)
  status                                    String            @default("pending")
  assignedTo                                String?
  assignmentType                            String            @default("single") // 'single', 'multiple', 'open'
  dueDate                                   DateTime?
  createdAt                                 DateTime          @default(now())
  completedAt                               DateTime?
  // Recurring chore fields
  isRecurring                               Boolean           @default(false)
  recurrencePattern                         String? // 'daily', 'weekly', 'monthly', 'custom'
  recurrenceConfig                          Json? // Custom schedule config: { daysOfWeek: [1,3,5], interval: 2, etc. }
  parentChoreId                             String? // For recurring instances, points to the template chore
  nextOccurrenceDate                        DateTime? // When the next occurrence should be generated
  recurrenceEndDate                         DateTime? // When to stop generating occurrences
  recurrenceCount                           Int? // How many occurrences to generate (null = infinite)
  occurrencesGenerated                      Int               @default(0) // Track how many occurrences have been created
  User_Chore_assignedToToUser               User?             @relation("Chore_assignedToToUser", fields: [assignedTo], references: [id])
  User_Chore_createdByToUser                User              @relation("Chore_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  User_Chore_friendIdToUser                 User?             @relation("Chore_friendIdToUser", fields: [friendId], references: [id])
  Group                                     Group?            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  Chore_Chore_parentChoreIdToChore          Chore?            @relation("ChoreRecurrence", fields: [parentChoreId], references: [id], onDelete: Cascade)
  Chore_Chore_parentChoreIdToChore_children Chore[]           @relation("ChoreRecurrence")
  ChoreCompletion                           ChoreCompletion[]
  ChoreHistory                              ChoreHistory[]
  ChoreAssignment                           ChoreAssignment[]
  ChoreReminder                             ChoreReminder[]
  ChoreRotation                             ChoreRotation[]
  reminderEnabled                           Boolean           @default(true)
  reminderHoursBefore                       Int? // e.g., 24 for 24 hours before due date
  // Rotation fields
  rotationEnabled                           Boolean           @default(false)
  rotationType                              String? // 'round-robin', 'fairness-based', 'random'
}

model ChoreCompletion {
  id           String   @id
  choreId      String
  userId       String
  completedAt  DateTime @default(now())
  pointsEarned Int
  onTime       Boolean  @default(true)
  Chore        Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChoreHistory {
  id        String   @id
  choreId   String?
  action    String
  userId    String
  changes   Json?
  notes     String?
  createdAt DateTime @default(now())
  Chore     Chore?   @relation(fields: [choreId], references: [id])
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([choreId, createdAt])
  @@index([choreId])
}

model ChoreAssignment {
  id           String    @id @default(uuid())
  choreId      String
  userId       String
  assignedAt   DateTime  @default(now())
  completedAt  DateTime?
  pointsEarned Int?
  onTime       Boolean?
  Chore        Chore     @relation(fields: [choreId], references: [id], onDelete: Cascade)
  User         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([choreId, userId])
  @@index([choreId])
  @@index([userId])
  @@index([choreId, completedAt])
}

model ChoreReminder {
  id           String    @id @default(uuid())
  choreId      String
  userId       String
  reminderAt   DateTime
  sent         Boolean   @default(false)
  sentAt       DateTime?
  reminderType String    @default("due_date") // 'due_date', 'overdue'
  Chore        Chore     @relation(fields: [choreId], references: [id], onDelete: Cascade)
  User         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([choreId, userId, reminderType])
  @@index([choreId, reminderAt])
  @@index([userId, reminderAt])
  @@index([sent, reminderAt])
  @@index([reminderAt])
}

model ChoreRotation {
  id             String    @id @default(uuid())
  choreId        String
  userId         String
  rotationOrder  Int       @default(0)
  lastAssignedAt DateTime?
  skipUntil      DateTime? // Skip user until date (e.g., vacation)
  Chore          Chore     @relation(fields: [choreId], references: [id], onDelete: Cascade)
  User           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([choreId, userId])
  @@index([choreId])
  @@index([userId])
  @@index([choreId, rotationOrder])
}

model Expense {
  id                           String           @id
  createdBy                    String
  description                  String
  amount                       Float
  currency                     String           @default("USD")
  date                         DateTime         @default(now())
  createdAt                    DateTime         @default(now())
  groupId                      String?
  receiptUrl                   String?
  category                     String?
  paidBy                       String?
  splitType                    SplitType        @default(EQUAL)
  rideId                       String? // Link to Ride if this expense was created from a ride
  User_Expense_createdByToUser User             @relation("Expense_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  Group                        Group?           @relation(fields: [groupId], references: [id])
  User_Expense_paidByToUser    User?            @relation("Expense_paidByToUser", fields: [paidBy], references: [id])
  Ride                         Ride?            @relation(fields: [rideId], references: [id], onDelete: SetNull)
  ExpenseHistory               ExpenseHistory[]
  ExpenseSplit                 ExpenseSplit[]

  @@index([rideId])
}

model ExpenseHistory {
  id        String   @id
  expenseId String?
  action    String
  userId    String
  changes   Json?
  notes     String?
  createdAt DateTime @default(now())
  Expense   Expense? @relation(fields: [expenseId], references: [id])
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expenseId, createdAt])
  @@index([expenseId])
}

model ExpenseSplit {
  id              String           @id
  expenseId       String
  userId          String
  amount          Float
  isPaid          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  paidAt          DateTime?
  Expense         Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  User            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  SettlementSplit SettlementSplit?
}

model FinanceAccount {
  id            String          @id
  userId        String
  name          String
  currency      String          @default("USD")
  balance       Float           @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now())
  context       String          @default("local")
  accountType   String          @default("checking")
  Budget        Budget[]
  User          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  FinancialGoal FinancialGoal[]

  @@index([userId, context])
}

model FinanceTransaction {
  id               String            @id
  accountId        String?
  type             String
  amount           Float
  category         String?
  description      String?
  date             DateTime          @default(now())
  createdAt        DateTime          @default(now())
  userId           String
  context          String            @default("local")
  source           String?
  expenseSplitId   String?
  budgetId         String?
  goalId           String?
  loanId           String?
  updatedAt        DateTime          @default(now())
  Budget           Budget?           @relation(fields: [budgetId], references: [id])
  FinancialGoal    FinancialGoal?    @relation(fields: [goalId], references: [id])
  User             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  GoalContribution GoalContribution?

  @@index([userId, context, date])
  @@index([userId, context, type])
  @@index([userId, date])
}

model FinancialGoal {
  id                 String               @id
  userId             String
  context            String
  name               String
  targetAmount       Float
  currentAmount      Float                @default(0)
  targetDate         DateTime?
  category           String               @default("savings")
  priority           String               @default("medium")
  status             String               @default("active")
  accountId          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  completedAt        DateTime?
  FinanceTransaction FinanceTransaction[]
  FinanceAccount     FinanceAccount?      @relation(fields: [accountId], references: [id])
  User               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  GoalContribution   GoalContribution[]

  @@index([userId, context])
  @@index([userId, status])
}

model Friend {
  id                         String    @id
  userId                     String
  friendId                   String
  status                     String    @default("pending")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime
  acceptedAt                 DateTime?
  User_Friend_friendIdToUser User      @relation("Friend_friendIdToUser", fields: [friendId], references: [id], onDelete: Cascade)
  User_Friend_userIdToUser   User      @relation("Friend_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
  @@index([status])
  @@index([userId])
}

model GoalContribution {
  id                 String              @id
  goalId             String
  amount             Float
  transactionId      String?             @unique
  date               DateTime            @default(now())
  notes              String?
  createdAt          DateTime            @default(now())
  FinancialGoal      FinancialGoal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  FinanceTransaction FinanceTransaction? @relation(fields: [transactionId], references: [id])

  @@index([goalId, date])
}

model Group {
  id                 String            @id
  name               String
  description        String?
  icon               String?           @default("group")
  avatarUrl          String?
  allowMemberEditing Boolean           @default(false)
  visibility         GroupVisibility   @default(private)
  createdBy          String
  createdAt          DateTime          @default(now())
  Chore              Chore[]
  Expense            Expense[]
  Listing            Listing[]
  Post               Post[]
  User               User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  GroupMember        GroupMember[]
  GroupInvitation    GroupInvitation[]
  GroupJoinRequest   GroupJoinRequest[]
  Chat               Chat[]
}

model GroupMember {
  id        String          @id
  groupId   String
  userId    String
  createdAt DateTime        @default(now())
  role      GroupMemberRole @default(MEMBER)
  Group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  User      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model GroupInvitation {
  id           String    @id
  groupId      String
  invitedBy    String
  email        String?
  mobileNumber String?
  userId       String? // If user exists in system
  token        String    @unique
  status       String    @default("pending") // pending, accepted, declined, expired
  expiresAt    DateTime
  acceptedAt   DateTime?
  declinedAt   DateTime?
  createdAt    DateTime  @default(now())
  Group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  Inviter      User      @relation("GroupInvitationInviter", fields: [invitedBy], references: [id], onDelete: Cascade)
  Invitee      User?     @relation("GroupInvitationInvitee", fields: [userId], references: [id], onDelete: SetNull)

  @@index([groupId, status])
  @@index([email])
  @@index([mobileNumber])
  @@index([token])
  @@index([userId, status])
}

model GroupJoinRequest {
  id        String                  @id
  groupId   String
  userId    String
  status    GroupJoinRequestStatus  @default(pending)
  handledBy String?
  handledAt DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  Group     Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  User      User                    @relation("GroupJoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  Handler   User?                   @relation("GroupJoinRequestHandler", fields: [handledBy], references: [id], onDelete: SetNull)

  @@unique([groupId, userId])
  @@index([groupId, status])
  @@index([userId, status])
}

model UserInvitation {
  id           String    @id
  invitedBy    String
  email        String?
  mobileNumber String?
  token        String    @unique
  status       String    @default("pending") // pending, accepted, expired
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  Inviter      User      @relation("UserInvitationInviter", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([mobileNumber])
  @@index([token])
  @@index([status])
}

model Listing {
  id              String            @id
  userId          String
  groupId         String?
  type            String
  title           String
  description     String
  location        String?
  price           Float?
  currency        String?           @default("USD")
  status          String            @default("active")
  images          String[]
  views           Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  metadata        Json?
  User            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  Group           Group?            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ListingComment  ListingComment[]
  ListingFavorite ListingFavorite[]

  @@index([groupId, createdAt])
}

model ListingComment {
  id        String   @id
  listingId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([listingId])
  @@index([userId])
}

model ListingFavorite {
  id        String   @id
  userId    String
  listingId String
  createdAt DateTime @default(now())
  Listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
  @@index([userId])
}

model Post {
  id            String        @id
  userId        String
  groupId       String?
  content       String?
  images        String[]
  location      String?
  hashtags      String[]
  likesCount    Int           @default(0)
  commentsCount Int           @default(0)
  sharesCount   Int           @default(0)
  viewsCount    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  deletedAt     DateTime?
  User          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  Group         Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  PostLike      PostLike[]
  PostComment   PostComment[]
  PostShare     PostShare[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([hashtags])
  @@index([groupId, createdAt])
}

model PostLike {
  id        String   @id
  userId    String
  postId    String
  createdAt DateTime @default(now())
  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model PostComment {
  id        String   @id
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  deletedAt DateTime?
  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([postId])
}

model PostShare {
  id        String   @id
  postId    String
  userId    String
  createdAt DateTime @default(now())
  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Loan {
  id               String    @id
  userId           String
  context          String
  name             String
  lender           String
  principalAmount  Float
  remainingAmount  Float
  interestRate     Float
  emi              Float
  loanTerm         Int
  remainingMonths  Int
  startDate        DateTime
  nextPaymentDate  DateTime
  paymentFrequency String    @default("monthly")
  accountId        String?
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  completedAt      DateTime?

  @@index([userId, context])
  @@index([userId, status])
}

model LoanPayment {
  id            String   @id
  loanId        String
  amount        Float
  principalPaid Float
  interestPaid  Float
  paymentDate   DateTime
  transactionId String?  @unique
  notes         String?
  createdAt     DateTime @default(now())

  @@index([loanId, paymentDate])
}

model Message {
  id        String    @id
  chatId    String
  senderId  String
  content   String
  sentAt    DateTime  @default(now())
  readAt    DateTime?
  deletedAt DateTime?
  editedAt  DateTime?
  Chat      Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  User      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

model Ride {
  id              String            @id
  driverId        String
  type            String
  origin          String
  destination     String
  distance        Float?
  chargePerMile   Float?
  chargePerRide   Float?
  totalCost       Float
  currency        String            @default("USD")
  date            DateTime          @default(now())
  createdAt       DateTime          @default(now())
  expenseId       String?
  User            User              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  RideParticipant RideParticipant[]
  Expense         Expense[]         @relation // Bidirectional: Expense.rideId → Ride.id
}

model RideParticipant {
  id        String   @id
  rideId    String
  userId    String
  isDriver  Boolean  @default(false)
  createdAt DateTime @default(now())
  Ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rideId, userId])
}

model RideFavorite {
  id            String   @id
  userId        String
  name          String // e.g., "School run with John"
  passengerIds  String[] // Array of user IDs to charge
  chargePerMile Float?
  chargePerRide Float?
  origin        String?
  destination   String?
  groupId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Settlement {
  id                            String            @id
  payerId                       String
  payeeId                       String
  amount                        Float
  currency                      String            @default("USD")
  paymentMethod                 String
  notes                         String?
  settledAt                     DateTime          @default(now())
  createdAt                     DateTime          @default(now())
  User_Settlement_payeeIdToUser User              @relation("Settlement_payeeIdToUser", fields: [payeeId], references: [id], onDelete: Cascade)
  User_Settlement_payerIdToUser User              @relation("Settlement_payerIdToUser", fields: [payerId], references: [id], onDelete: Cascade)
  SettlementSplit               SettlementSplit[]
}

model SettlementSplit {
  id           String       @id
  settlementId String
  splitId      String       @unique
  Settlement   Settlement   @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  ExpenseSplit ExpenseSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)

  @@unique([settlementId, splitId])
}

model TrustScore {
  id                String              @id
  userId            String              @unique
  score             Int                 @default(0)
  verified          Boolean             @default(false)
  updatedAt         DateTime            @default(now())
  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  TrustScoreHistory TrustScoreHistory[]
}

model TrustScoreHistory {
  id           String     @id
  trustScoreId String
  score        Int
  reason       String?
  createdAt    DateTime   @default(now())
  TrustScore   TrustScore @relation(fields: [trustScoreId], references: [id], onDelete: Cascade)
}

model TrustScoreRankHistory {
  id         String   @id
  userId     String
  category   String   @default("overall")
  rank       Int
  totalUsers Int
  period     String   @default("all-time")
  date       DateTime
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([category, period, date])
  @@unique([userId, category, period, date])
}

model User {
  id                                     String               @id
  email                                  String               @unique
  mobileNumber                           String?              @unique
  password                               String
  createdAt                              DateTime             @default(now())
  passwordResetToken                     String?
  passwordResetExpires                   DateTime?
  emailVerified                          Boolean              @default(false)
  emailVerificationToken                 String?
  updatedAt                              DateTime
  Budget                                 Budget[]
  ChatParticipant                        ChatParticipant[]
  Chore_Chore_assignedToToUser           Chore[]              @relation("Chore_assignedToToUser")
  Chore_Chore_createdByToUser            Chore[]              @relation("Chore_createdByToUser")
  Chore_Chore_friendIdToUser             Chore[]              @relation("Chore_friendIdToUser")
  ChoreCompletion                        ChoreCompletion[]
  ChoreHistory                           ChoreHistory[]
  ChoreAssignment                        ChoreAssignment[]
  ChoreReminder                          ChoreReminder[]
  ChoreRotation                          ChoreRotation[]
  Expense_Expense_createdByToUser        Expense[]            @relation("Expense_createdByToUser")
  Expense_Expense_paidByToUser           Expense[]            @relation("Expense_paidByToUser")
  ExpenseHistory                         ExpenseHistory[]
  ExpenseSplit                           ExpenseSplit[]
  FinanceAccount                         FinanceAccount[]
  FinanceTransaction                     FinanceTransaction[]
  FinancialGoal                          FinancialGoal[]
  Friend_Friend_friendIdToUser           Friend[]             @relation("Friend_friendIdToUser")
  Friend_Friend_userIdToUser             Friend[]             @relation("Friend_userIdToUser")
  Group                                  Group[]
  GroupMember                            GroupMember[]
  GroupInvitation_GroupInvitationInviter GroupInvitation[]    @relation("GroupInvitationInviter")
  GroupInvitation_GroupInvitationInvitee GroupInvitation[]    @relation("GroupInvitationInvitee")
  GroupJoinRequest_GroupJoinRequestUser  GroupJoinRequest[]   @relation("GroupJoinRequestUser")
  GroupJoinRequest_GroupJoinRequestHandler GroupJoinRequest[] @relation("GroupJoinRequestHandler")
  UserInvitation_UserInvitationInviter   UserInvitation[]     @relation("UserInvitationInviter")
  Listing                                Listing[]
  ListingComment                         ListingComment[]
  ListingFavorite                        ListingFavorite[]
  Post                                   Post[]
  PostLike                               PostLike[]
  PostComment                            PostComment[]
  PostShare                              PostShare[]
  Message                                Message[]
  Notification                           Notification[]
  Ride                                   Ride[]
  RideParticipant                        RideParticipant[]
  RideFavorite                           RideFavorite[]
  Settlement_Settlement_payeeIdToUser    Settlement[]         @relation("Settlement_payeeIdToUser")
  Settlement_Settlement_payerIdToUser    Settlement[]         @relation("Settlement_payerIdToUser")
  TrustScore                             TrustScore?
  TrustScoreRankHistory                  TrustScoreRankHistory[]
  UserProfile                            UserProfile?
}

model UserProfile {
  id                   String   @id
  userId               String   @unique
  displayName          String?
  avatarUrl            String?
  bio                  String?
  createdAt            DateTime @default(now())
  primaryCurrency      String?  @default("USD")
  homeCountryCurrency  String?  @default("USD")
  choreReminders       Boolean  @default(true)
  emailNotifications   Boolean  @default(true)
  expenseReminders     Boolean  @default(true)
  listingNotifications Boolean  @default(true)
  messageNotifications Boolean  @default(true)
  notificationsEnabled Boolean  @default(true)
  pushNotifications    Boolean  @default(true)
  profileVisibility    String   @default("public")
  trustScoreVisibility String   @default("public")
  theme                String   @default("system")
  language             String   @default("en")
  fontSize             String   @default("medium")
  highContrast         Boolean  @default(false)
  User                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum GroupMemberRole {
  ADMIN
  MEMBER
}

enum GroupVisibility {
  public
  private
}

enum GroupJoinRequestStatus {
  pending
  approved
  declined
  cancelled
}

enum SplitType {
  EQUAL
  CUSTOM
  PERCENTAGE
}
