# Backend environment variables (example)
# Copy to .env (do not commit .env)

# Local Postgres in Docker is mapped to localhost:5433 (because Windows Postgres uses 5432)
DATABASE_URL="postgresql://dreamfinora:dreamfinora_dev_password_change_in_production@localhost:5433/dreamfinora_dev?schema=public"

# Backend port
PORT=3001

# JWT secret (use a strong random string in production)
JWT_SECRET=dreamfinora_dev_secret_change_in_production

# Frontend URL for invitation links
FRONTEND_URL=http://localhost:3000

# Email Service (SendGrid) - Free tier: 100 emails/day forever
# Get API key from: https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# SENDGRID_FROM_EMAIL=noreply@dreamfinora.com

# SMS Service (Twilio) - Free trial: $15.50 credit
# Get credentials from: https://console.twilio.com/
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

